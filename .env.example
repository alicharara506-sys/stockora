# --- Database ---
# PostgreSQL connection string. Prisma 7 connects through a driver adapter
# (@prisma/adapter-pg), so this must be a reachable Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockora?schema=public"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth.js ---
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Required in production when the app runs behind a reverse proxy or in a
# container (Docker, Fly, Railway, self-hosted). Without it a production build
# rejects every request with "UntrustedHost". Vercel sets this automatically.
AUTH_TRUST_HOST="true"

# Optional Google OAuth (omit both to disable the Google login button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email ---
# Resend API key. Without it, auth emails (verification, password reset)
# are logged to the server console instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="Stockora <no-reply@stockora.com>"

# --- AI Assistant ---
# Two provider options — set at most one. If both are set, GROQ_API_KEY wins.
# Without either, the AI assistant chat still works (conversations and messages
# persist) but replies with a message explaining it isn't connected.

# Option 1 (free): Groq. Sign up at https://console.groq.com — no payment
# method required. Create an API key under "API Keys" and paste it below.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Option 2 (paid): Anthropic. https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
